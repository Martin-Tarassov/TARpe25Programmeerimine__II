@model IEnumerable<ShopTARpe25.Models.Spaceship.SpaceshipIndexViewModel>

@{
    int rowNumber = 1;
}

<p>
    <a asp-action="Create" class="btn btn-success">Create New</a>
</p>

<form method="get">
    <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col">Nr</th>
                <th scope="col">Name</th>
                <th scope="col">Type</th>
                <th scope="col">Built Date</th>
                <th scope="col">Crew</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @{
                int nr = 1;
            }
            @foreach (var spaceship in Model)
            {
                <tr>
                    <td>@rowNumber</td>
                    <td>@spaceship.Name</td>
                    <td>@spaceship.Classification</td>
                    <td>@spaceship.BuiltDate</td>
                    <td>@spaceship.Crew</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@spaceship.Id" class="btn btn-primary">Details</a>
                        <a asp-action="Update" asp-route-id="@spaceship.Id" class="btn btn-primary">Update</a>
                        <a asp-action="Delete" asp-route-id="@spaceship.Id" class="btn btn-danger">Delete</a>
                    </td>
                </tr>
                    rowNumber++;
                }
        </tbody>
    </table>
</form>